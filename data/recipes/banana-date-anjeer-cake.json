  "steps": [
    "Preheat oven to 180°C. Line or grease a loaf/square tin.",
    "In a bowl, mix mashed bananas, date-anjeer paste, melted ghee, buttermilk, lemon juice, vanilla.",
    "In another bowl, mix atta, oats flour, baking powder, baking soda, cinnamon, salt.",
    "Fold wet into dry — don’t overmix. Add walnuts/choco chips if using.",
    "Pour into tin, smooth the top.",
    "Bake at 180°C for 35–40 mins. Check at 35 with a toothpick.",
    "Cool fully before slicing — makes 12 slices.",
    "Microwave 10–15 sec before eating for that fresh-out-of-the-oven feel!"
  ],
  "assumptions": [
    "The 120–130 g paste is 8–10 dates and 4–5 anjeer soaked in hot water and blended.",
